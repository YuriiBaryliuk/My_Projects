import requests
import pandas as pd

SHOP = "alpsdiscovery-dev-2.myshopify.com"
ACCESS_TOKEN = ""
API_VERSION = "2026-01"

url = f"https://{SHOP}/admin/api/{API_VERSION}/graphql.json"

headers = {
    "Content-Type": "application/json",
    "X-Shopify-Access-Token": ACCESS_TOKEN,
}

get_products = """
query ProductsWithQuoteInVendor($first: Int!, $after: String) {
    products(first: $first, after: $after) {
      edges {
        cursor
        node {
          id
          title
          vendor
        }
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
"""

all_products = []
has_next_page = True
after = None

counter = 0

while has_next_page:
    variable = {
        'first': 100,
        "after": after,
    }

    response = requests.post(
        url,
        json={
            "query": get_products,
            "variables": variable,
        },
        headers=headers,
        timeout=30,
    )

    data = response.json()
    product_list = data['data']['products']['edges']

    for product in product_list:
        print(product['node']['vendor'])
        if product['node']['vendor'] == "\"Collosol\"":
            counter += 1




    has_next_page = data["data"]["products"]["pageInfo"]["hasNextPage"]
    after = data["data"]["products"]["pageInfo"]["endCursor"]

print(counter)
