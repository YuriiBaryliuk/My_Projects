import requests
import pandas as pd

SHOP = "alpsdiscovery-dev-2.myshopify.com"
ACCESS_TOKEN = ""
API_VERSION = "2026-01"

url = f"https://{SHOP}/admin/api/{API_VERSION}/graphql.json"

headers = {
    "Content-Type": "application/json",
    "X-Shopify-Access-Token": ACCESS_TOKEN,
}

get_collections = """
query ListCollections($first: Int = 100, $after: String) {
  collections(first: $first, after: $after) {
    edges {
      cursor
      node {
        id
        title
      }
    }
    pageInfo {
      hasNextPage
      endCursor
    }
  }
}
"""

get_products = """
query CollectionProductsPage($collectionId: ID!,  $first: Int = 100, $after: String) {
  collection(id: $collectionId) {
    id
    title
    products(first: $first, after: $after) {
      edges {
        cursor
        node {
          id
          title
          description
          featuredMedia {
            preview {
              image {
                url
              }
            }
          }
        }
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
}
"""

get_variants = """
query ProductWithVariants($id: ID!, $first: Int = 50, $after: String) {
  product(id: $id) {
    id
    variants(first: $first, after: $after) {
      edges {
        node {
          id
          title
          price
          compareAtPrice
          inventoryQuantity
          inventoryItem {
            unitCost {
              amount
            }
          }
          media(first: 1) {
            edges {
              node {
                preview {
                  image {
                    url
                    altText
                  }
                }
              }
            }
          }
        }
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
}
"""


def get_all_collections():
    collections = []
    after = None

    while True:

        variable = {
            "after": after,
            "pageSize": 50,
        }

        response = requests.post(
            url,
            json={
                "query": get_collections,
                "variables": variable,
            },
            headers=headers,
            timeout=30,
        )
        data = response.json()
        connection = data["data"]["collections"]

        for edge in connection["edges"]:
            collections.append({"id": edge["node"]["id"], "title": edge["node"]["title"]})

        if not connection["pageInfo"]["hasNextPage"]:
            break
        after = connection["pageInfo"]["endCursor"]

    return collections


def get_all_products_for_collection(collection_id):
    products = []
    after = None

    while True:
        variable = {
            "collectionId": collection_id["id"],
            "pageSize": 100,
            "after": after,
        }

        response = requests.post(
            url,
            json={
                "query": get_products,
                "variables": variable,
            },
            headers=headers,
            timeout=30,
        )

        data = response.json()
        connection = data["data"]["collection"]["products"]

        for edge in connection["edges"]:
            have_image = edge["node"]["featuredMedia"] is not None
            products.append({"id": edge["node"]["id"], "title": edge["node"]["title"], "description": edge["node"]["description"], "have_image": have_image})

        if not connection["pageInfo"]["hasNextPage"]:
            break
        after = connection["pageInfo"]["endCursor"]

    return products


def get_variants_for_product(product_id):
    variants = []
    after = None

    while True:
        response = requests.post(
            url,
            json={
                "query": get_variants,
                "variables": {"id": product_id, "first": 50, "after": after},
            },
            headers=headers,
            timeout=30,
        )
        data = response.json()
        connection = data["data"]["product"]["variants"]

        for edge in connection["edges"]:
            node = edge["node"]
            variant_have_image = len(edge["node"]["media"]["edges"]) > 0
            variant_in_inventory = edge["node"]["inventoryQuantity"] > 0
            inventory_item = node["inventoryItem"]
            unit_cost = None

            if inventory_item and inventory_item["unitCost"]:
                unit_cost = inventory_item["unitCost"]["amount"]
            variants.append({
                "id": node["id"],
                "have_image": variant_have_image,
                "price": node["price"],
                "compare_at_price": node["compareAtPrice"],
                "unit_cost": unit_cost,
                "in_inventory": variant_in_inventory,
            })

        if not connection["pageInfo"]["hasNextPage"]:
            break
        after = connection["pageInfo"]["endCursor"]

    return variants

excel_list_collection_names = []
excel_list_quantity = []
excel_list_no_description = []
excel_list_no_images = []
excel_list_variants_quantity = []
excel_list_variants_no_images = []
excel_list_variants_no_price = []
excel_list_variants_no_compare_at_price = []
excel_list_variants_no_unit_cost = []
excel_list_variants_in_inventory = []

collections = get_all_collections()
print("Number of collections:", len(collections))

for collection in collections:
    print(f"\nCollection: {collection['title']} ({collection['id']})")
    excel_list_collection_names.append(collection['title'])
    products = get_all_products_for_collection(collection)

    # <=======For products=========>

    # Quantity
    print("Quantity:", len(products))

    if not products:
        print("  (No products in this collection)")

        excel_list_quantity.append(0)
        excel_list_no_description.append(0)
        excel_list_no_images.append(0)
        excel_list_variants_quantity.append(0)
        excel_list_variants_no_images.append(0)
        excel_list_variants_no_price.append(0)
        excel_list_variants_no_compare_at_price.append(0)
        excel_list_variants_no_unit_cost.append(0)
        excel_list_variants_in_inventory.append(0)

        continue

    excel_list_quantity.append(len(products))

    # Count if have no description and image

    description_counter = 0
    image_counter = 0
    for product in products:
        if not product["description"]:
            description_counter += 1
        if not product["have_image"]:
            image_counter += 1
    print(f"No descriptions: {description_counter}\nNo images: {image_counter}")
    excel_list_no_description.append(description_counter)
    excel_list_no_images.append(image_counter)

    # <=======For variants=========>
    print("\nFor variants:")
    variant_quantity_counter = 0
    variant_image_counter = 0
    variant_price_counter = 0
    variant_compareAtPrice_counter = 0
    variant_unitCost_counter = 0
    variant_inventory_quantity_counter = 0
    for product in products:
        variants = get_variants_for_product(product["id"])
        variants_length = len(variants)
        variant_quantity_counter += variants_length
        for variant in variants:
            if not variant["have_image"] and variants_length > 1:
                variant_image_counter += 1
            if not variant["price"]:
                variant_price_counter += 1
            if not variant["compare_at_price"]:
                variant_compareAtPrice_counter += 1
            if not variant["unit_cost"]:
                variant_unitCost_counter += 1
            if variant["in_inventory"]:
                variant_inventory_quantity_counter += 1


    print(f"Variants quantity: {variant_quantity_counter}\n"
          f"No images for variants: {variant_image_counter}\n"
          f"No price: {variant_price_counter}\n"
          f"No compareAtPrice: {variant_compareAtPrice_counter}\n"
          f"No unitCost: {variant_unitCost_counter}\n"
          f"Are in inventory: {variant_inventory_quantity_counter}")

    excel_list_variants_quantity.append(variant_quantity_counter)
    excel_list_variants_no_images.append(variant_image_counter)
    excel_list_variants_no_price.append(variant_price_counter)
    excel_list_variants_no_compare_at_price.append(variant_compareAtPrice_counter)
    excel_list_variants_no_unit_cost.append(variant_unitCost_counter)
    excel_list_variants_in_inventory.append(variant_inventory_quantity_counter)

print(excel_list_quantity)
print(excel_list_no_description)
print(excel_list_no_images)
print(excel_list_variants_quantity)
print(excel_list_variants_no_images)
print(excel_list_variants_no_price)
print(excel_list_variants_no_compare_at_price)
print(excel_list_variants_no_unit_cost)
print(excel_list_variants_in_inventory)


df = pd.DataFrame({
    "Name": excel_list_collection_names,
    "Quantity": excel_list_quantity,
    "NoDescriptions": excel_list_no_description,
    "NoImages": excel_list_no_images,
    "VariantsQuantity": excel_list_variants_quantity,
    "VariantsNoImages": excel_list_variants_no_images,
    "VariantsNoPrice": excel_list_variants_no_price,
    "VariantsNoCompareAtPrice": excel_list_variants_no_compare_at_price,
    "VariantsNoUnitCost": excel_list_variants_no_unit_cost,
    "VariantsInInventory": excel_list_variants_in_inventory
})

df.to_excel("quantities.xlsx", index=False)
