def _money_str(d: dict | None, *path: str, default: str = "0.00") -> str:
    cur = d or {}
    for p in path:
        cur = (cur or {}).get(p)
        if cur is None:
            return default
    return str(cur)


def _money_float(d: dict | None, *path: str) -> Optional[float]:
    v = _money_str(d, *path, default=None)
    try:
        return float(v) if v is not None else None
    except (TypeError, ValueError):
        return None


