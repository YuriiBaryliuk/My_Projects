class OrderSortKey(str, Enum):
    ID = "ID"
    CREATED_AT = "CREATED_AT"
    UPDATED_AT = "UPDATED_AT"
    TOTAL_PRICE = "TOTAL_PRICE"


class OrdersQueryParams(BaseModel):
    query: Optional[str] = None
    limit: int = 50
    after: Optional[str] = None
    before: Optional[str] = None
    reverse: bool = True
    sort_key: OrderSortKey = OrderSortKey.CREATED_AT


async def parse_orders_query(
    query: Optional[str] = Query(None),
    limit: int = Query(50, ge=1, le=250),
    after: Optional[str] = Query(None),
    before: Optional[str] = Query(None),
    reverse: bool = Query(True),
    sort_key: OrderSortKey = Query(OrderSortKey.CREATED_AT),
) -> OrdersQueryParams:
    return OrdersQueryParams(
        query=query,
        limit=limit,
        after=after,
        before=before,
        reverse=reverse,
        sort_key=sort_key,
    )


# New Order Operation Schemas

class RefundRequest(BaseModel):
    reason: Optional[str] = Field(None, description="Reason for the refund")
    note: Optional[str] = Field(None, description="Additional note for the refund")


class RefundResponse(BaseModel):
    order_id: int = Field(..., description="The order ID")
    status: str = Field(..., description="Status of the refund operation")
    refund_id: Optional[str] = Field(None, description="The refund ID from Shopify")
    message: str = Field(..., description="Human-readable message about the operation")


class DuplicateRequest(BaseModel):
    include_line_items: bool = Field(True, description="Whether to include line items in the duplicate")
    include_shipping: bool = Field(True, description="Whether to include shipping information")


class DuplicateResponse(BaseModel):
    original_order_id: int = Field(..., description="The original order ID")
    new_order_id: Optional[str] = Field(None, description="The new order ID (if created as order)")
    draft_order_id: Optional[str] = Field(None, description="The draft order ID (if created as draft)")
    status: str = Field(..., description="Status of the duplication operation")
    message: str = Field(..., description="Human-readable message about the operation")


class CancelRequest(BaseModel):
    reason: Optional[str] = Field(None, description="Reason for cancellation (customer, fraud, inventory, declined)")
    restock: bool = Field(True, description="Whether to restock the items")


class CancelResponse(BaseModel):
    order_id: int = Field(..., description="The order ID")
    status: str = Field(..., description="Status of the cancellation operation")
    cancelled_at: Optional[str] = Field(None, description="Timestamp when the order was cancelled")
    message: str = Field(..., description="Human-readable message about the operation")


class ArchiveRequest(BaseModel):
    reason: Optional[str] = Field(None, description="Reason for archiving the order")


class ArchiveResponse(BaseModel):
    order_id: int = Field(..., description="The order ID")
    status: str = Field(..., description="Status of the archive operation")
    archived_at: Optional[str] = Field(None, description="Timestamp when the order was archived")
