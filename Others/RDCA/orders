from fastapi import HTTPException
from pydantic import BaseModel

router = APIRouter(prefix="/orders", tags=["orders"])


class RefundRequest(BaseModel):
    reason: Optional[str] = None
    note: Optional[str] = None


class RefundResponse(BaseModel):
    order_id: int
    status: str
    refund_id: Optional[str] = None
    message: str


class DuplicateRequest(BaseModel):
    include_line_items: bool = True
    include_shipping: bool = True


class DuplicateResponse(BaseModel):
    original_order_id: int
    new_order_id: Optional[str] = None
    draft_order_id: Optional[str] = None
    status: str
    message: str


class CancelRequest(BaseModel):
    reason: Optional[str] = None
    restock: bool = True


class CancelResponse(BaseModel):
    order_id: int
    status: str
    cancelled_at: Optional[str] = None
    message: str


class ArchiveRequest(BaseModel):
    reason: Optional[str] = None


class ArchiveResponse(BaseModel):
    order_id: int
    status: str
    archived_at: Optional[str] = None
    message: str


@router.post(
    "/{order_id}/refund",
    response_model=RefundResponse,
    dependencies=[Depends(authenticate_user)],
    summary="Refund an order",
    description="Initiates a refund for the specified order."
)
async def refund_order(
        order_id: int,
        request: RefundRequest,
        shopify_client: ShopifyClientGraphQl = Depends(get_shopify_GraphQl_client),
):
    service = OrderService(shopify_client)
    try:
        result = await service.refund_order(order_id, reason=request.reason, note=request.note)
        return RefundResponse(
            order_id=order_id,
            status="success",
            refund_id=result.get("refund_id"),
            message=result.get("message", "Order refund initiated successfully")
        )
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))


@router.post(
    "/{order_id}/duplicate",
    response_model=DuplicateResponse,
    dependencies=[Depends(authenticate_user)],
    summary="Duplicate an order",
    description="Creates a duplicate of the specified order as a draft order."
)
async def duplicate_order(
        order_id: int,
        request: DuplicateRequest,
        shopify_client: ShopifyClientGraphQl = Depends(get_shopify_GraphQl_client),
):
    service = OrderService(shopify_client)
    try:
        result = await service.duplicate_order(
            order_id,
            include_line_items=request.include_line_items,
            include_shipping=request.include_shipping
        )
        return DuplicateResponse(
            original_order_id=order_id,
            new_order_id=result.get("new_order_id"),
            draft_order_id=result.get("draft_order_id"),
            status="success",
            message=result.get("message", "Order duplicated successfully")
        )
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))


