        order_id: int,
        request: DuplicateRequest,
        shopify_client: ShopifyClientGraphQl = Depends(get_shopify_GraphQl_client),
):
    service = OrderService(shopify_client)
    try:
        result = await service.duplicate_order(
            order_id,
