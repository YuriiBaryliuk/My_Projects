#include <iostream>
#include <cstdlib>
#include <time.h>

using namespace std;

int input() {
	
	cout << "Enter a number from 1 to 100: ";
	int num;
	cin >> num;
	return num;
}

int randNumber() {

	srand(static_cast<unsigned int>(time(0)));
	int random = 1 + (rand() % 99);
	return random;
}

int func(int random) {

	for (int i = 0; i <= 6; i++)
	{

		int number = input();

		if (number < random) {

			cout << "Your number is too low" << endl;
		}

		else if (number > random) {

			cout << "Your number is too high" << endl;
		}

		else {

			return 1;
		}

	}

	return 0;

}

int main() {

	int random = randNumber();

	while (true) {

		if (func(random)) {
			cout << "You win" << endl;
		}

		else {

			cout << "You lose" << endl;
		}

		cout << "Do you want to play again (y: yes / n: no)" << endl;
		char ch;
		cin >> ch;

		cin.ignore(32676, '\n');

		if (ch == 'y')
			continue;
		else if (ch == 'n')
			break;
		else
			cout << "Uncorrect answer" << endl;
			break;

	}
	return 0;
}
